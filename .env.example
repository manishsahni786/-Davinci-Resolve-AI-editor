# Copy to .env and adjust. Environment variables override config/settings.json.

# Detected automatically from the running process / Start Menu shortcut when omitted.
AVE_RESOLVE_INSTALL_DIR=D:\Softwares\New Folder

# Runtime data and logs. Defaults are <project>\data and <project>\logs.
# AVE_DATA_DIR=C:\Users\manis\OneDrive\Desktop\Divinci+ Opencode\data
# AVE_LOG_DIR=C:\Users\manis\OneDrive\Desktop\Divinci+ Opencode\logs

# How long the Node process waits for the Resolve Lua bridge.
AVE_COMMAND_TIMEOUT_MS=120000
AVE_POLL_INTERVAL_MS=500

# Resolve Free requires the Bridge script to be launched manually for each request.
# Keep the optional Windows UI trigger disabled unless you explicitly choose otherwise.
AVE_AUTO_TRIGGER=false
AVE_AUTO_TRIGGER_INTERVAL_MS=1500
# AVE_AUTO_TRIGGER_SCRIPT=C:\path\to\invoke-bridge.ps1

# Optional offline media analysis. The runner prefers the project .venv when it exists.
# Set AVE_PYTHON_PATH when using a different Python installation.
# AVE_PYTHON_PATH=D:\path\to\project\.venv\Scripts\python.exe
# For local Ollama, use API_STYLE=ollama and BASE_URL=http://127.0.0.1:11434 (no /v1 suffix).
# AVE_VISION_API_STYLE=ollama
# AVE_VISION_BASE_URL=http://127.0.0.1:11434
# AVE_VISION_MODEL=qwen3-vl:2b
# AVE_VISION_ALLOW_REMOTE=false
# AVE_VISION_API_KEY=ollama
# Keep the event request small and serial on 4 GB GPUs. Live allocation is read from
# Ollama /api/ps after warm-up and each inference response. Runs stop above this CPU split.
# AVE_VISION_EVENT_NUM_CTX=5120
# AVE_VISION_BATCH_SIZE=1
# AVE_VISION_MAX_REQUESTS=24
# AVE_VISION_MAX_CPU_OFFLOAD_PERCENT=20
# AVE_VISION_NUM_CTX=5120
# AVE_VISION_NUM_PREDICT=2048
# Retry a truncated response with a doubled output budget, up to 8192 tokens.
# AVE_VISION_REQUEST_TIMEOUT_SECONDS=600
# AVE_VISION_KEEP_ALIVE=45m
# AVE_VISION_WARMUP=true
# Per-request model response logs are stored under analysis-cache/vision-requests/<jobId>.jsonl.
# AVE_VISION_REQUEST_LOG=1
# Event analysis overall deadline is enforced in Python and by the Node worker supervisor.
# AVE_ANALYSIS_DEADLINE_SECONDS=2400
# AVE_ANALYSIS_TIMEOUT_MS=2700000
# How long successful analysis results stay cached under data/analysis-cache/results.
# AVE_ANALYSIS_TTL_MS=604800000
# AVE_FFPROBE_PATH=C:\path\to\ffprobe.exe
# AVE_FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFmpeg/FFprobe are required for probe_media/analyze_media. If they are not on PATH,
# set both to absolute executable paths (e.g. the WinGet Gyan.FFmpeg package bin folder).
# AVE_WHISPER_MODEL_PATH=C:\path\to\local\faster-whisper-model

# Ollama server tuning is separate from this project's .env. Set before starting
# the Ollama server process, then restart it. On Windows PowerShell, for example:
#   $env:OLLAMA_FLASH_ATTENTION = "1"
#   $env:OLLAMA_KV_CACHE_TYPE = "q8_0"
#   $env:OLLAMA_NUM_PARALLEL = "1"
#   $env:OLLAMA_MAX_LOADED_MODELS = "1"
#   ollama serve
# q8_0 KV cache requires Flash Attention. These values affect every model on that server.

# debug | info | warn | error
AVE_LOG_LEVEL=info
